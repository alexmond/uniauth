<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.alexmond</groupId>
        <artifactId>uniauth-parent</artifactId>
        <version>4.1.0.3-SNAPSHOT</version>
    </parent>

    <artifactId>uniauth-examples</artifactId>
    <packaging>pom</packaging>

    <name>UniAuth Examples</name>
    <description>Runnable examples for the UniAuth starter. Each one is a whole application rather
        than a snippet, and each shows a different way of consuming the library. Not published to
        Maven Central — these are documentation, not artifacts.
    </description>

    <modules>
        <module>webapp</module>
        <module>headless</module>
    </modules>

    <build>
        <plugins>
            <!--
              Examples are documentation, never artifacts. The central-publishing plugin is active
              in the release profile, so its skip is set here for every example module to inherit;
              without it a release would push a demo application to Maven Central.
            -->
            <plugin>
                <groupId>org.sonatype.central</groupId>
                <artifactId>central-publishing-maven-plugin</artifactId>
                <configuration>
                    <skipPublishing>true</skipPublishing>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
